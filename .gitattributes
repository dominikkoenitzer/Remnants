* text=auto

LICENSE.txt eol=crlf
ThirdPartyNotices.txt eol=crlf

*.bat eol=crlf
*.cmd eol=crlf
*.ps1 eol=lf
*.sh eol=lf
*.rtf -text
**/*.json linguist-language=jsonc

# Upstream Code - OSS tree. This code is Microsoft's, not this repository
# author's — mark it vendored so GitHub Linguist excludes it from the
# language statistics. See CHANGES.md for what this repo actually changes.
src/**              linguist-vendored
extensions/**       linguist-vendored
build/**            linguist-vendored
test/**             linguist-vendored
cli/**              linguist-vendored
remote/**           linguist-vendored
scripts/**          linguist-vendored
.eslint-plugin-local/** linguist-vendored
